## blink — ESP32-S2-Mini（Wemos S2 Mini）基线工程（测试固件）
# 芯片 ESP32-S2FN4R2（4MB flash + 2MB QSPI PSRAM 片内封装），无蓝牙
CONFIG_IDF_TARGET="esp32s2"

# S2 没有 USB-Serial-JTAG：控制台走原生 USB-OTG 的 ROM CDC（本板无 USB-UART 桥）。
# 注意：ROM bootloader 阶段日志仍走 UART0（GPIO43/44，本板未引出），USB 上看不到
CONFIG_ESP_CONSOLE_USB_CDC=y

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 任务看门狗超时触发 panic 重启（主循环 1s 一拍喂狗）
CONFIG_ESP_TASK_WDT_PANIC=y

# S2 单核 LX7 满频 240MHz
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# 片内 2MB QSPI PSRAM（官方标称；⚠ 尚未上真机验证——启动卡死先降 40M 或关 SPIRAM，
# 见 esp32-s3-zero 的 PSRAM 教训）
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
